# Configuración de Variables de Entorno
# Copia este archivo como .env y configura los valores según tu entorno

# ============================================
# Configuración de la Aplicación
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ============================================
# Configuración de Base de Datos
# ============================================

# Para Azure SQL Database (recomendado - usar con Terraform):
# IMPORTANTE: Usa las mismas credenciales que configuraste en terraform.tfvars
# Después de ejecutar 'npm run generate-env' o '.\scripts.ps1 generate-env', 
# el archivo .env.azure se generará automáticamente con los valores correctos
DB_HOST=sql-peaceful-xxxxx.database.windows.net
DB_PORT=1433
DB_USERNAME=sqladmin
DB_PASSWORD=TuContraseñaSegura123!@#
DB_DATABASE=peaceful_db
DB_ENCRYPT=true

# Para Docker local (opcional - solo si no usas Azure SQL):
# DB_HOST=db
# DB_PORT=1433
# DB_USERNAME=sa
# DB_PASSWORD=YourStrong@Passw0rd
# DB_DATABASE=peaceful_db
# DB_ENCRYPT=false
