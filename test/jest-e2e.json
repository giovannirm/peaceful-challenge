{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@employees/(.*)$": "<rootDir>/src/employees/$1",
    "^@attendance/(.*)$": "<rootDir>/src/attendance/$1",
    "^@shared/(.*)$": "<rootDir>/src/shared/$1"
  }
}
